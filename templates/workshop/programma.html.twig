{% extends 'base.html.twig' %}

{% block title %}Programma{% endblock %}

{% block body %}
    <style>
        .example-wrapper {
            margin: 1em auto;
            max-width: 800px;
            width: 95%;
            font: 18px/1.5 sans-serif;
        }
        .example-wrapper code {
            background: #f5f5f5;
            padding: 2px 6px;
        }
    </style>

    <div class="container-md my-5">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">Workshop</th>
                    <th scope="col">Omschrijving</th>
                    <th scope="col">Gastheer</th>
                    <th scope="col">Lokaal</th>
                    <th scope="col">Starttijd</th>
                    <th scope="col">Eindtijd</th>
                    <th scope="col">Plekken</th>
                    <th scope="col">Minimale leeftijd</th>
                    <th scope="col">Actief</th>
                </tr>
            </thead>
            <tbody>
                {% for workshop in workshops %}
        
                    <tr>
                        <td>{{ workshop.title }}</td>
                        <td>{{ workshop.description }}</td>
                        <td>{{ workshop.host }}</td>
                        <td>{{ workshop.room }}</td>
                        <td>{{ workshop.startTime|date('H:i') }}</td>
                        <td>{{ workshop.endTime|date('H:i') }}</td>
                        <td>{{ workshop.capacity }}</td>
                        <td>{{ workshop.minAge }}</td>
                        <td>{{ workshop.active }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
