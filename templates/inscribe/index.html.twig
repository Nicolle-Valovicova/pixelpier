{% extends 'base.html.twig' %}

{% block title %}Inschrijven{% endblock %}

{% block body %}
    <style>
        .example-wrapper {
            margin: 1em auto;
            max-width: 800px;
            width: 95%;
            font: 18px/1.5 sans-serif;
        }
        .example-wrapper code {
            background: #f5f5f5;
            padding: 2px 6px;
        }
    </style>

    <div class="container-md my-5">
        {{ form_start(form) }}
        <div class="row d-flex">
            <div class="col-xs-6">
                {{ form_row(form.firstName) }}
                {{ form_errors(form.firstName, {'attr': {'class': 'red-text'}}) }}
            </div>
            <div class="col-xs-6">
                {{ form_row(form.lastName) }}
                {{ form_errors(form.lastName, {'attr': {'class': 'red-text'}}) }}
            </div>
        </div>
        
        {{ form_end(form) }}
    </div>
{% endblock %}
